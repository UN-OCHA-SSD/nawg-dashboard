{
  "name": "nawg-dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "data:export": "node scripts/export-public-snapshot.mjs",
    "data:refresh": "node scripts/export-public-snapshot.mjs --refresh",
    "test:pages": "node --test tests/public-snapshot.test.mjs tests/map-viewport.test.mjs tests/analytics-model.test.mjs",
    "preview": "vite preview",
    "start": "node server/serve.mjs",
    "test": "node --test tests/data-model.test.mjs tests/map-viewport.test.mjs tests/analytics-model.test.mjs",
    "test:ui": "node scripts/check-combined-ui.mjs",
    "test:reset": "node scripts/check-reset-ui.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "leaflet": "^1.9.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^3.10.1",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
